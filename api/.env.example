# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
# DigitalOcean Managed Postgres connection string (found in the database console)
DATABASE_URL=postgresql://pgl_user:YOUR_PASSWORD@localhost:5432/pgl

# ── Square ────────────────────────────────────────────────────────────────────
# "production" or "sandbox"
SQUARE_ENV=sandbox

# Access token from your Square Developer Dashboard
# Sandbox: starts with EAAAl...  Production: starts with EAAAl... (same format)
SQUARE_ACCESS_TOKEN=YOUR_SQUARE_ACCESS_TOKEN_HERE

# ── Email (Resend) ────────────────────────────────────────────────────────────
# API key from resend.com — free tier covers 3,000 emails/month
RESEND_API_KEY=re_YOUR_RESEND_KEY_HERE

# The verified sending address. Must match a domain you've verified in Resend.
EMAIL_FROM=PGL <noreply@pulsegolfleague.com>

# Admin email to receive alerts when a registration attempt fails
# Leave blank to disable alerts
ADMIN_ALERT_EMAIL=your@email.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://pulsegolfleague.com,https://www.pulsegolfleague.com

# ── Payment scheduling ────────────────────────────────────────────────────────
# ISO date (YYYY-MM-DD) — cards will be charged on or after this date
CHARGE_DATE=2026-08-25

# ── Admin panel ───────────────────────────────────────────────────────────────
# Password required to access the /admin page and all /api/admin/* endpoints.
# Choose a strong, random password (e.g. openssl rand -base64 32).
ADMIN_PASSWORD=CHOOSE_A_STRONG_ADMIN_PASSWORD
