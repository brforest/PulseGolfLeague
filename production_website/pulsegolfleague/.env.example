# Square Web Payments SDK Configuration
# Copy this file to .env and fill in your actual Square credentials.
# Get these from your Square Developer Dashboard: https://developer.squareup.com/

# Your Square Application ID
# Sandbox IDs start with "sandbox-sq0idb-"
VITE_SQUARE_APP_ID=sandbox-sq0idb-YOUR_APP_ID_HERE

# Your Square Location ID
# Found in the Locations section of your Square Developer Dashboard
VITE_SQUARE_LOCATION_ID=YOUR_LOCATION_ID_HERE

# Environment: "sandbox" for testing, "production" for live
# This controls which Square CDN script is loaded:
#   sandbox  → https://sandbox.web.squarecdn.com/v1/square.js
#   production → https://web.squarecdn.com/v1/square.js
VITE_SQUARE_ENV=sandbox

# Backend API URL
# Development: http://localhost:3001
# Production: https://yourdomain.com  (if nginx proxies /api to port 3001)
#             or https://api.pulsegolfleague.com
VITE_API_URL=http://localhost:3001
